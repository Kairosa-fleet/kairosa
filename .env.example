# ---------- Backend ----------
DATABASE_URL=postgresql+asyncpg://tracking:tracking_dev_pw@localhost:5432/tracking
REDIS_URL=redis://localhost:6379/0

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=CHANGE_ME
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
DEVICE_TOKEN_EXPIRE_DAYS=365

# Browsers treat localhost and 127.0.0.1 as different origins — list both.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Reject pings older than this many seconds (replay protection)
MAX_PING_AGE_SECONDS=86400
# Drop pings whose reported accuracy is worse than this (metres)
MAX_ACCURACY_METERS=100

# ---------- Maps (MapLibre engine, swappable tile provider) ----------
# maptiler | ola | custom   — switching providers is this value + its key, no code change
MAP_PROVIDER=maptiler

# MapTiler: https://cloud.maptiler.com/start/  (no credit card, 100k loads/month free)
MAPTILER_KEY=CHANGE_ME
MAPTILER_STYLE=streets-v2

# Ola Maps (optional, India-optimised): https://maps.olakrutrim.com  (5M calls/month free)
OLA_MAPS_API_KEY=
OLA_MAPS_STYLE=default-light-standard

# ---------- Web (Next.js) ----------
NEXT_PUBLIC_MAP_PROVIDER=maptiler
NEXT_PUBLIC_MAPTILER_KEY=CHANGE_ME
NEXT_PUBLIC_OLA_MAPS_API_KEY=
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_WS_BASE_URL=ws://localhost:8000

# ---------- Mobile (React Native + Expo) ----------
# Expo reads EXPO_PUBLIC_* into the client bundle. Never put secrets here —
# the device token is issued at provisioning and stored in the OS keystore.
# No per-platform map keys, no SHA-1 fingerprints — MapLibre needs none of that.
EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:8000
EXPO_PUBLIC_WS_BASE_URL=ws://10.0.2.2:8000
EXPO_PUBLIC_MAPTILER_KEY=NSnX1UuK4rsfRKRBJcjw
EXPO_PUBLIC_MAP_PROVIDER=maptiler
